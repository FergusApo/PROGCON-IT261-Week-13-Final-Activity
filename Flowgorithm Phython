def checkWinner(board):
    result = "None"
    filledCount = 0
    
    # Check rows
    if board[1] != " " and board[1] == board[2] and board[2] == board[3]:
        result = board[1]
    if board[4] != " " and board[4] == board[5] and board[5] == board[6]:
        result = board[4]
    if board[7] != " " and board[7] == board[8] and board[8] == board[9]:
        result = board[7]
    
    # Check columns
    if board[1] != " " and board[1] == board[4] and board[4] == board[7]:
        result = board[1]
    if board[2] != " " and board[2] == board[5] and board[5] == board[8]:
        result = board[2]
    if board[3] != " " and board[3] == board[6] and board[6] == board[9]:
        result = board[3]
    
    # Check diagonals
    if board[1] != " " and board[1] == board[5] and board[5] == board[9]:
        result = board[1]
    if board[3] != " " and board[3] == board[5] and board[5] == board[7]:
        result = board[3]
    
    # Check for draw
    for k in range(1, 10):
        if board[k] != " ":
            filledCount += 1
    
    if result == "None" and filledCount == 9:
        result = "Draw"
  
    return result
 
 
def displayBoard(board):
    print(f"\n {board[1]} | {board[2]} | {board[3]} ")
    print("---+---+---")
    print(f" {board[4]} | {board[5]} | {board[6]} ")
    print("---+---+---")
    print(f" {board[7]} | {board[8]} | {board[9]} \n")
 
 
def getComputerMove(board):
    valid = False
    while not valid:
        compMove = random.randint(1, 9)
        if board[compMove] == " ":
            valid = True
    return compMove
 
 
# Main execution block
if __name__ == "__main__":
    board = [" "] * 10
    gameOver = False
    winner = "None"
    
    # Randomly pick who goes first (0 = Human, 1 = Computer)
    currentPlayer = random.choice(["O", "X"])
    print(f"Player {currentPlayer} starts the game!")
 
    while not gameOver:
        displayBoard(board)
       
    if currentPlayer == "O":
            validMove = False
            while not validMove:
                try:
                    humanMove = int(input("Enter your move (1-9): "))
                    if 1 <= humanMove <= 9:
                        if board[humanMove] == " ":
                            validMove = True
                        else:
                            print("Space occupied! Try again.")
                    else:
                        print("Invalid choice! Enter a number between 1 and 9.")
                except ValueError:
                    print("Invalid input! Please enter an integer.")
            board[humanMove] = "O"
        else:
            print("Computer's turn...")
            compChoice = getComputerMove(board)
            board[compChoice] = "X"
        winner = checkWinner(board)
        if winner != "None":
            gameOver = True
        else:
            currentPlayer = "X" if currentPlayer == "O" else "O"
 
    displayBoard(board)
    if winner == "O":
        print("You win!")
    elif winner == "X":
        print("Computer wins!")
    else:
        print("It's a draw!")
